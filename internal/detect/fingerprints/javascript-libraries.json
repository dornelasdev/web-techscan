{
  "schema_version": 1,
  "technologies": [
    {
      "id": "jquery",
      "name": "jQuery",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-core-runtime",
          "state": "inferred",
          "description": "Paired prototype initialization and expando construction in captured JavaScript suggest jQuery",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*fn\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*prototype\\s*=\\s*\\{\\s*jquery\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*constructor\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*length\\s*:\\s*0\\s*[,}]"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:\\{|,)\\s*expando\\s*:\\s*(?:\"jQuery\"|'jQuery')\\s*\\+\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\+\\s*Math\\s*\\.\\s*random\\s*\\(\\s*\\)\\s*\\)\\s*\\.\\s*replace\\s*\\(\\s*/\\\\D/g\\s*,\\s*(?:\"\"|'')\\s*\\)\\s*[,}]"
            }
          ]
        }
      ]
    },
    {
      "id": "lazysizes",
      "name": "lazySizes",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-core-runtime",
          "state": "inferred",
          "description": "Paired configuration initialization and core API mappings in captured JavaScript suggest lazySizes",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*lazySizesConfig\\s*\\|\\|\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*lazysizesConfig\\s*\\|\\|\\s*\\{\\s*\\}\\s*(?:[;,)}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "\\{\\s*cfg\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*autoSizer\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*loader\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*init\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*uP\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*aC\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*rC\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*hC\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*fire\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*gW\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*(?:\\s*,\\s*rAF\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*)?\\s*,?\\s*\\}"
            }
          ]
        }
      ]
    },
    {
      "id": "modernizr",
      "name": "Modernizr",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-v2-core-runtime",
          "state": "inferred",
          "description": "Paired factory initialization and prefix metadata assignments in captured JavaScript suggest Modernizr",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*Modernizr\\s*=\\s*\\(?\\s*function\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\)\\s*\\{"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*_domPrefixes\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*[;,]\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*_cssomPrefixes\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            }
          ]
        }
      ]
    }
  ]
}
