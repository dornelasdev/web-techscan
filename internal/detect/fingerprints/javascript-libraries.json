{
  "schema_version": 1,
  "technologies": [
    {
      "id": "htmx",
      "name": "htmx",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-v1-v2-core-runtime",
          "state": "inferred",
          "description": "Paired request-header construction and configuration lookup in captured JavaScript suggest htmx",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "\\{\\s*(?:\"HX-Request\"|'HX-Request')\\s*:\\s*(?:\"true\"|'true')\\s*,\\s*(?:\"HX-Trigger\"|'HX-Trigger')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*(?:\"id\"|'id')\\s*\\)\\s*,\\s*(?:\"HX-Trigger-Name\"|'HX-Trigger-Name')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*(?:\"name\"|'name')\\s*\\)\\s*,\\s*(?:\"HX-Target\"|'HX-Target')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*(?:\"id\"|'id')\\s*\\)\\s*,\\s*(?:\"HX-Current-URL\"|'HX-Current-URL')\\s*:\\s*(?:[A-Za-z_$][A-Za-z0-9_$]*\\s*\\(\\s*\\)\\s*\\.\\s*)?location\\s*\\.\\s*href\\s*,?\\s*\\}"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\(\\s*\\)\\s*\\.\\s*querySelector\\s*\\(\\s*(?:'meta\\[name=\"htmx-config\"\\]'|\"meta\\[name='htmx-config'\\]\")\\s*\\)"
            }
          ]
        },
        {
          "id": "asset-v4-core-runtime",
          "state": "inferred",
          "description": "Paired source-header construction and document configuration lookup in captured JavaScript suggest htmx",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "\\{\\s*(?:\"HX-Request\"|'HX-Request')\\s*:\\s*(?:\"true\"|'true')\\s*,\\s*(?:\"HX-Source\"|'HX-Source')\\s*:\\s*this\\s*\\.\\s*#[A-Za-z_$][A-Za-z0-9_$]*\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\)\\s*,\\s*(?:\"HX-Current-URL\"|'HX-Current-URL')\\s*:\\s*location\\s*\\.\\s*href\\s*,\\s*(?:Accept|\"Accept\"|'Accept')\\s*:\\s*(?:\"text/html\"|'text/html')\\s*,?\\s*\\}"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])document\\s*\\.\\s*querySelector\\s*\\(\\s*(?:'meta\\[name=\"htmx-config\"\\]'|\"meta\\[name='htmx-config'\\]\")\\s*\\)"
            }
          ]
        }
      ]
    },
    {
      "id": "jquery",
      "name": "jQuery",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-core-runtime",
          "state": "inferred",
          "description": "Paired prototype initialization and expando construction in captured JavaScript suggest jQuery",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*fn\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*prototype\\s*=\\s*\\{\\s*jquery\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*constructor\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*length\\s*:\\s*0\\s*[,}]"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:\\{|,)\\s*expando\\s*:\\s*(?:\"jQuery\"|'jQuery')\\s*\\+\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\+\\s*Math\\s*\\.\\s*random\\s*\\(\\s*\\)\\s*\\)\\s*\\.\\s*replace\\s*\\(\\s*/\\\\D/g\\s*,\\s*(?:\"\"|'')\\s*\\)\\s*[,}]"
            }
          ]
        }
      ]
    },
    {
      "id": "lazysizes",
      "name": "lazySizes",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-core-runtime",
          "state": "inferred",
          "description": "Paired configuration initialization and core API mappings in captured JavaScript suggest lazySizes",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*lazySizesConfig\\s*\\|\\|\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*lazysizesConfig\\s*\\|\\|\\s*\\{\\s*\\}\\s*(?:[;,)}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "\\{\\s*(?:/\\*[^*]*\\*+(?:[^/*][^*]*\\*+)*/\\s*)?cfg\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*autoSizer\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*loader\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*init\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*uP\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*aC\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*rC\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*hC\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*fire\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*gW\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*(?:\\s*,\\s*rAF\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*)?\\s*,?\\s*\\}"
            }
          ]
        }
      ]
    },
    {
      "id": "modernizr",
      "name": "Modernizr",
      "category": "javascript_library",
      "rules": [
        {
          "id": "asset-v2-core-runtime",
          "state": "inferred",
          "description": "Paired factory initialization and prefix metadata assignments in captured JavaScript suggest Modernizr",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*Modernizr\\s*=\\s*\\(?\\s*function\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\)\\s*\\{"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*_domPrefixes\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*[;,]\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*_cssomPrefixes\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            }
          ]
        },
        {
          "id": "asset-v3-core-registration",
          "state": "inferred",
          "description": "Paired core configuration and test-registration structures in captured JavaScript suggest Modernizr",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])(?:_config|\"_config\"|'_config')\\s*:\\s*\\{\\s*(?:classPrefix|\"classPrefix\"|'classPrefix')\\s*:\\s*(?:\"(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])*\"|'(?:[^'\\\\\\r\\n]|\\\\[^\\r\\n])*')\\s*,\\s*(?:enableClasses|\"enableClasses\"|'enableClasses')\\s*:\\s*(?:true|false|!\\s*[01])\\s*,\\s*(?:enableJSClass|\"enableJSClass\"|'enableJSClass')\\s*:\\s*(?:true|false|!\\s*[01])\\s*,\\s*(?:usePrefixes|\"usePrefixes\"|'usePrefixes')\\s*:\\s*(?:true|false|!\\s*[01])\\s*,?\\s*\\}"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\])(?:addTest|\"addTest\"|'addTest')\\s*:\\s*function\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\)\\s*\\{\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*push\\s*\\(\\s*\\{\\s*(?:name|\"name\"|'name')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*(?:fn|\"fn\"|'fn')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,\\s*(?:options|\"options\"|'options')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,?\\s*\\}\\s*\\)\\s*;?\\s*\\}\\s*,\\s*(?:addAsyncTest|\"addAsyncTest\"|'addAsyncTest')\\s*:\\s*function\\s*\\(\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\)\\s*\\{\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*push\\s*\\(\\s*\\{\\s*(?:name|\"name\"|'name')\\s*:\\s*null\\s*,\\s*(?:fn|\"fn\"|'fn')\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*,?\\s*\\}\\s*\\)\\s*;?\\s*\\}\\s*(?:[,}]|$)"
            }
          ]
        }
      ]
    }
  ]
}
