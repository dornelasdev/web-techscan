{
  "schema_version": 1,
  "technologies": [
    {
      "id": "drupal",
      "name": "Drupal",
      "category": "cms",
      "rules": [
        {
          "id": "generator-meta",
          "state": "inferred",
          "description": "HTML contains a generator meta tag naming Drupal; markup may be copied or static",
          "all": [
            {
              "source": "html",
              "pattern": "(?i:<meta)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?:(?i:name)\\s*=\\s*(?:\"(?i:generator)\"|'(?i:generator)')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?i:content)\\s*=\\s*(?:\"Drupal\\s+[0-9]+(?:\\.[0-9]+)*(?:\\s+\\(https?://(?:www\\.)?drupal\\.org/?\\))?\"|'Drupal\\s+[0-9]+(?:\\.[0-9]+)*(?:\\s+\\(https?://(?:www\\.)?drupal\\.org/?\\))?')|(?i:content)\\s*=\\s*(?:\"Drupal\\s+[0-9]+(?:\\.[0-9]+)*(?:\\s+\\(https?://(?:www\\.)?drupal\\.org/?\\))?\"|'Drupal\\s+[0-9]+(?:\\.[0-9]+)*(?:\\s+\\(https?://(?:www\\.)?drupal\\.org/?\\))?')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?i:name)\\s*=\\s*(?:\"(?i:generator)\"|'(?i:generator)'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?)*\\s*/?>"
            }
          ]
        },
        {
          "id": "generator-header",
          "state": "detected",
          "description": "X-Generator header reports Drupal",
          "all": [
            {
              "source": "header",
              "name": "X-Generator",
              "pattern": "(?i)^[ \\t]*Drupal[ \\t]+[0-9]+(?:\\.[0-9]+)*(?:[ \\t]+\\(https?://(?:www\\.)?drupal\\.org/?\\))?[ \\t]*$"
            }
          ]
        }
      ]
    },
