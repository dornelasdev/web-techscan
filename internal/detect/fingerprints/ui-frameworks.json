{
  "schema_version": 1,
  "technologies": [
    {
      "id": "bootstrap",
      "name": "Bootstrap",
      "category": "ui_framework",
      "rules": [
        {
          "id": "asset-css-banner-and-buttons",
          "state": "inferred",
          "description": "Bootstrap banner and button CSS variable declarations/usage suggest Bootstrap",
          "all": [
            {
              "source": "asset_css",
              "pattern": "(?s:/\\*![\\s*]*Bootstrap\\s+v5\\.[23]\\.[0-9]+\\s+\\(https://getbootstrap\\.com/\\).*?\\*/)"
            },
            {
              "source": "asset_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*\\.btn\\s*\\{\\s*(?:[^{}]*;\\s*)?--bs-btn-padding-x\\s*:\\s*[^;{}\\s][^;{}]*;\\s*(?:[^{}]*;\\s*)?padding\\s*:\\s*var\\(\\s*--bs-btn-padding-y\\s*\\)\\s+var\\(\\s*--bs-btn-padding-x\\s*\\)\\s*(?:;[^{}]*)?\\}"
            }
          ]
        },
        {
          "id": "inline-css-banner-and-buttons",
          "state": "inferred",
          "description": "Bootstrap banner and button CSS variable declarations/usage in one inline style block suggest Bootstrap",
          "all": [
            {
              "source": "inline_css",
              "pattern": "(?s:/\\*![\\s*]*Bootstrap\\s+v5\\.[23]\\.[0-9]+\\s+\\(https://getbootstrap\\.com/\\).*?\\*/)"
            },
            {
              "source": "inline_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*\\.btn\\s*\\{\\s*(?:[^{}]*;\\s*)?--bs-btn-padding-x\\s*:\\s*[^;{}\\s][^;{}]*;\\s*(?:[^{}]*;\\s*)?padding\\s*:\\s*var\\(\\s*--bs-btn-padding-y\\s*\\)\\s+var\\(\\s*--bs-btn-padding-x\\s*\\)\\s*(?:;[^{}]*)?\\}"
            }
          ]
        }
      ]
    },
    {
      "id": "tailwindcss",
      "name": "Tailwind CSS",
      "category": "ui_framework",
      "rules": [
        {
          "id": "asset-css-v3-banner-and-preflight",
          "state": "inferred",
          "description": "Tailwind banner and generated preflight content declaration suggest Tailwind CSS",
          "all": [
            {
              "source": "asset_css",
              "pattern": "/\\*!\\s*tailwindcss\\s+v3\\.4\\.[0-9]+\\s+\\|\\s+MIT License\\s+\\|\\s+https://tailwindcss\\.com\\s*\\*/"
            },
            {
              "source": "asset_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*(?:::?before\\s*,\\s*::?after|::?after\\s*,\\s*::?before)\\s*\\{\\s*--tw-content\\s*:\\s*(?:\"\"|'')\\s*;?\\s*\\}"
            }
          ]
        },
        {
          "id": "asset-css-v4-banner-and-translate",
          "state": "inferred",
          "description": "Tailwind banner and generated translate property registration/declaration/usage suggest Tailwind CSS",
          "all": [
            {
              "source": "asset_css",
              "pattern": "/\\*!\\s*tailwindcss\\s+v4\\.1\\.[0-9]+\\s+\\|\\s+MIT License\\s+\\|\\s+https://tailwindcss\\.com\\s*\\*/"
            },
            {
              "source": "asset_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*@property\\s+--tw-translate-x\\s*\\{\\s*syntax\\s*:\\s*(?:\"\\*\"|'\\*')\\s*;\\s*inherits\\s*:\\s*false\\s*;\\s*initial-value\\s*:\\s*0\\s*;?\\s*\\}"
            },
            {
              "source": "asset_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*[^{};]+\\{\\s*(?:[^{}]*;\\s*)?--tw-translate-x\\s*:\\s*[^;{}\\s][^;{}]*;\\s*(?:[^{}]*;\\s*)?translate\\s*:\\s*var\\(\\s*--tw-translate-x\\s*\\)\\s+var\\(\\s*--tw-translate-y\\s*\\)\\s*(?:;[^{}]*)?\\}"
            }
          ]
        },
        {
          "id": "inline-css-v3-banner-and-preflight",
          "state": "inferred",
          "description": "Tailwind banner and generated preflight content declaration in one inline style block suggest Tailwind CSS",
          "all": [
            {
              "source": "inline_css",
              "pattern": "/\\*!\\s*tailwindcss\\s+v3\\.4\\.[0-9]+\\s+\\|\\s+MIT License\\s+\\|\\s+https://tailwindcss\\.com\\s*\\*/"
            },
            {
              "source": "inline_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*(?:::?before\\s*,\\s*::?after|::?after\\s*,\\s*::?before)\\s*\\{\\s*--tw-content\\s*:\\s*(?:\"\"|'')\\s*;?\\s*\\}"
            }
          ]
        },
        {
          "id": "inline-css-v4-banner-and-translate",
          "state": "inferred",
          "description": "Tailwind banner and generated translate property registration/declaration/usage in one inline style block suggest Tailwind CSS",
          "all": [
            {
              "source": "inline_css",
              "pattern": "/\\*!\\s*tailwindcss\\s+v4\\.1\\.[0-9]+\\s+\\|\\s+MIT License\\s+\\|\\s+https://tailwindcss\\.com\\s*\\*/"
            },
            {
              "source": "inline_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*@property\\s+--tw-translate-x\\s*\\{\\s*syntax\\s*:\\s*(?:\"\\*\"|'\\*')\\s*;\\s*inherits\\s*:\\s*false\\s*;\\s*initial-value\\s*:\\s*0\\s*;?\\s*\\}"
            },
            {
              "source": "inline_css",
              "pattern": "(?:^|[{}]|\\*/)\\s*[^{};]+\\{\\s*(?:[^{}]*;\\s*)?--tw-translate-x\\s*:\\s*[^;{}\\s][^;{}]*;\\s*(?:[^{}]*;\\s*)?translate\\s*:\\s*var\\(\\s*--tw-translate-x\\s*\\)\\s+var\\(\\s*--tw-translate-y\\s*\\)\\s*(?:;[^{}]*)?\\}"
            }
          ]
        }
      ]
    },
    {
      "id": "radix-ui",
      "name": "Radix UI",
      "category": "ui_framework",
      "rules": [
        {
          "id": "asset-popover-style-mappings",
          "state": "inferred",
          "description": "Radix popover transform-origin and available-size variable mappings suggest Radix UI",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "\\{\\s*(?:[^{}]*,\\s*)?(?:\"--radix-popover-content-transform-origin\"|'--radix-popover-content-transform-origin')\\s*:\\s*(?:\"var\\(--radix-popper-transform-origin\\)\"|'var\\(--radix-popper-transform-origin\\)')\\s*,\\s*(?:\"--radix-popover-content-available-width\"|'--radix-popover-content-available-width')\\s*:\\s*(?:\"var\\(--radix-popper-available-width\\)\"|'var\\(--radix-popper-available-width\\)')\\s*,\\s*(?:\"--radix-popover-content-available-height\"|'--radix-popover-content-available-height')\\s*:\\s*(?:\"var\\(--radix-popper-available-height\\)\"|'var\\(--radix-popper-available-height\\)')\\s*(?:,[^{}]*)?\\}"
            }
          ]
        },
        {
          "id": "asset-tooltip-style-mappings",
          "state": "inferred",
          "description": "Radix tooltip transform-origin and available-size variable mappings suggest Radix UI",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "\\{\\s*(?:[^{}]*,\\s*)?(?:\"--radix-tooltip-content-transform-origin\"|'--radix-tooltip-content-transform-origin')\\s*:\\s*(?:\"var\\(--radix-popper-transform-origin\\)\"|'var\\(--radix-popper-transform-origin\\)')\\s*,\\s*(?:\"--radix-tooltip-content-available-width\"|'--radix-tooltip-content-available-width')\\s*:\\s*(?:\"var\\(--radix-popper-available-width\\)\"|'var\\(--radix-popper-available-width\\)')\\s*,\\s*(?:\"--radix-tooltip-content-available-height\"|'--radix-tooltip-content-available-height')\\s*:\\s*(?:\"var\\(--radix-popper-available-height\\)\"|'var\\(--radix-popper-available-height\\)')\\s*(?:,[^{}]*)?\\}"
            }
          ]
        }
      ]
    },
    {
      "id": "shadcn-ui",
      "name": "shadcn/ui",
      "category": "ui_framework",
      "rules": [
        {
          "id": "sidebar-html",
          "state": "inferred",
          "description": "Paired Sidebar wrapper, inner and menu HTML markers suggest shadcn/ui-derived components",
          "all": [
            {
              "source": "html",
              "pattern": "<[A-Za-z][A-Za-z0-9:_.-]*\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:[dD][aA][tT][aA]-[sS][lL][oO][tT]\\s*=\\s*(?:\"sidebar-wrapper\"|'sidebar-wrapper')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*[sS][tT][yY][lL][eE]\\s*=\\s*(?:\"\\s*(?:[^;{}\"'<>]*;\\s*)*(?:--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*|--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*)\\s*(?:;[^{}\"'<>]*)?\"|'\\s*(?:[^;{}\"'<>]*;\\s*)*(?:--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*|--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*)\\s*(?:;[^{}\"'<>]*)?')|[sS][tT][yY][lL][eE]\\s*=\\s*(?:\"\\s*(?:[^;{}\"'<>]*;\\s*)*(?:--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*|--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*)\\s*(?:;[^{}\"'<>]*)?\"|'\\s*(?:[^;{}\"'<>]*;\\s*)*(?:--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*|--sidebar-width-icon\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*;\\s*(?:[^;{}\"'<>]*;\\s*)*--sidebar-width\\s*:\\s*[^;{}\\s\"'<>][^;{}\"'<>]*)\\s*(?:;[^{}\"'<>]*)?')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*[dD][aA][tT][aA]-[sS][lL][oO][tT]\\s*=\\s*(?:\"sidebar-wrapper\"|'sidebar-wrapper'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            },
            {
              "source": "html",
              "pattern": "<[A-Za-z][A-Za-z0-9:_.-]*\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:[dD][aA][tT][aA]-[sS][lL][oO][tT]\\s*=\\s*(?:\"sidebar-inner\"|'sidebar-inner')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*[dD][aA][tT][aA]-[sS][iI][dD][eE][bB][aA][rR]\\s*=\\s*(?:\"sidebar\"|'sidebar')|[dD][aA][tT][aA]-[sS][iI][dD][eE][bB][aA][rR]\\s*=\\s*(?:\"sidebar\"|'sidebar')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*[dD][aA][tT][aA]-[sS][lL][oO][tT]\\s*=\\s*(?:\"sidebar-inner\"|'sidebar-inner'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            },
            {
              "source": "html",
              "pattern": "<[A-Za-z][A-Za-z0-9:_.-]*\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:[dD][aA][tT][aA]-[sS][lL][oO][tT]\\s*=\\s*(?:\"sidebar-menu\"|'sidebar-menu')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*[dD][aA][tT][aA]-[sS][iI][dD][eE][bB][aA][rR]\\s*=\\s*(?:\"menu\"|'menu')|[dD][aA][tT][aA]-[sS][iI][dD][eE][bB][aA][rR]\\s*=\\s*(?:\"menu\"|'menu')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*[dD][aA][tT][aA]-[sS][lL][oO][tT]\\s*=\\s*(?:\"sidebar-menu\"|'sidebar-menu'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            }
          ]
        }
      ]
    }
  ]
}
