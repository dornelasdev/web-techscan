{
  "schema_version": 1,
  "technologies": [
    {
      "id": "angular",
      "name": "Angular",
      "category": "javascript_framework",
      "rules": [
        {
          "id": "asset-component-runtime",
          "state": "inferred",
          "description": "Paired context-key, component-definition and host-version shapes in captured JavaScript suggest Angular",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[;,{}])\\s*(?:(?:var|let|const)\\s+)?[A-Za-z_$][A-Za-z0-9_$]*\\s*=\\s*(?:\"__ngContext__\"|'__ngContext__')\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$.\\\\ɵ])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*(?:ɵcmp|\\\\u0275cmp)\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*(?:\\s*\\.\\s*[A-Za-z_$][A-Za-z0-9_$]*)*\\s*\\(\\s*\\{\\s*type\\s*:\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*[,}]"
            },
            {
              "source": "asset_javascript",
              "pattern": "\\[\\s*(?:\"ng-version\"|'ng-version')\\s*,\\s*(?:\"(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\"|'(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)')\\s*\\]"
            }
          ]
        },
        {
          "id": "server-host-attributes",
          "state": "inferred",
          "description": "Paired ng-version and ng-server-context attributes on one tag suggest Angular",
          "all": [
            {
              "source": "html",
              "pattern": "(?i:<[A-Za-z][A-Za-z0-9:_.-]*)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:(?i:ng-version)\\s*=\\s*(?:\"(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\"|'(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:ng-server-context)\\s*=\\s*(?:\"[A-Za-z0-9-]+\"|'[A-Za-z0-9-]+')|(?i:ng-server-context)\\s*=\\s*(?:\"[A-Za-z0-9-]+\"|'[A-Za-z0-9-]+')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:ng-version)\\s*=\\s*(?:\"(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\"|'(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            }
          ]
        }
      ]
    },
    {
      "id": "aspnet-core",
      "name": "ASP.NET Core",
      "category": "framework",
      "rules": [{
        "id": "antiforgery-cookie-and-input",
        "state": "inferred",
        "description": "An ASP.NET Core-shaped antiforgery cookie name and a hidden __RequestVerificationToken input suggest ASP.NET Core",
        "all": [
          {"source": "cookie", "pattern": "^[.]AspNetCore[.]Antiforgery[.][A-Za-z0-9_-]{11}$"},
          {"source": "html", "pattern": "(?i:<input)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:(?i:type)\\s*=\\s*(?i:\"hidden\"|'hidden')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:name)\\s*=\\s*(?:\"__RequestVerificationToken\"|'__RequestVerificationToken')|(?i:name)\\s*=\\s*(?:\"__RequestVerificationToken\"|'__RequestVerificationToken')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:type)\\s*=\\s*(?i:\"hidden\"|'hidden'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"}
        ]
      }]
    },
    {
      "id": "django",
      "name": "Django",
      "category": "framework",
      "rules": [
        {
          "id": "csrf-cookie-and-input",
          "state": "inferred",
          "description": "csrftoken cookie name and a hidden csrfmiddlewaretoken input suggest Django",
          "all": [
            {
              "source": "cookie",
              "pattern": "^csrftoken$"
            },
            {
              "source": "html",
              "pattern": "(?i:<input)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:(?i:type)\\s*=\\s*(?i:\"hidden\"|'hidden')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:name)\\s*=\\s*(?:\"csrfmiddlewaretoken\"|'csrfmiddlewaretoken')|(?i:name)\\s*=\\s*(?:\"csrfmiddlewaretoken\"|'csrfmiddlewaretoken')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:type)\\s*=\\s*(?i:\"hidden\"|'hidden'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            }
          ]
        }
      ],
      "implies": ["python"]
    },
    {
      "id": "express",
      "name": "Express",
      "category": "framework",
      "rules": [{
        "id": "powered-by-header",
        "state": "detected",
        "description": "X-Powered-By header reports Express",
        "all": [{"source": "header", "name": "X-Powered-By", "pattern": "(?i)^[ \\t]*Express[ \\t]*$"}]
      }]
    },
    {
      "id": "fiber",
      "name": "Fiber",
      "category": "framework",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Fiber; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*[Ff][Ii][Bb][Ee][Rr][ \\t]*$"}]
      }]
    },
    {
      "id": "laravel",
      "name": "Laravel",
      "category": "framework",
      "rules": [{
        "id": "default-cookie-pair",
        "state": "inferred",
        "description": "laravel_session and XSRF-TOKEN cookie names suggest Laravel",
        "all": [
          {"source": "cookie", "pattern": "^laravel_session$"},
          {"source": "cookie", "pattern": "^XSRF-TOKEN$"}
        ]
      }],
      "implies": ["php"]
    },
    {
      "id": "nextjs",
      "name": "Next.js",
      "category": "framework",
      "rules": [
        {
          "id": "asset-build-manifest",
          "state": "inferred",
          "description": "A fetched script contains paired Next.js build-manifest assignment and callback markers",
          "all": [
            {"source": "asset_javascript", "pattern": "(?:^|[^A-Za-z0-9_$\\.])self\\s*\\.\\s*__BUILD_MANIFEST\\s*=\\s*(?:\\{|\\(?function\\s*\\()"},
            {"source": "asset_javascript", "pattern": "(?:^|[^A-Za-z0-9_$\\.])self\\s*\\.\\s*__BUILD_MANIFEST_CB\\s*&&\\s*self\\s*\\.\\s*__BUILD_MANIFEST_CB\\s*\\(\\s*\\)"}
          ]
        },
        {
          "id": "asset-ssg-manifest",
          "state": "inferred",
          "description": "A fetched script contains paired Next.js SSG-manifest assignment and callback markers",
          "all": [
            {"source": "asset_javascript", "pattern": "(?:^|[^A-Za-z0-9_$\\.])self\\s*\\.\\s*__SSG_MANIFEST\\s*=\\s*new\\s+Set(?:\\s*\\(|\\s*;)"},
            {"source": "asset_javascript", "pattern": "(?:^|[^A-Za-z0-9_$\\.])self\\s*\\.\\s*__SSG_MANIFEST_CB\\s*&&\\s*self\\s*\\.\\s*__SSG_MANIFEST_CB\\s*\\(\\s*\\)"}
          ]
        },
        {
          "id": "pages-html-markers",
          "state": "inferred",
          "description": "HTML contains a __NEXT_DATA__ script and a /_next/static/ script reference",
          "all": [
            {"source": "html", "pattern": "(?i:<script)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?i:id)\\s*=\\s*(?:\"__NEXT_DATA__\"|'__NEXT_DATA__')(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?)*\\s*/?>"},
            {"source": "html", "pattern": "(?i:<script)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?i:src)\\s*=\\s*(?:\"(?:(?:(?i:https?):)?//[^/\"'<>?#\\\\\\s]+/|/|[^/:\"'<>?#\\\\\\s]+/)(?:[^/:\"'<>?#\\\\\\s]+/)*_next/static/[^\"'<>?#\\\\\\s]+(?:[?#][^\"'<>\\\\\\s]*)?\"|'(?:(?:(?i:https?):)?//[^/\"'<>?#\\\\\\s]+/|/|[^/:\"'<>?#\\\\\\s]+/)(?:[^/:\"'<>?#\\\\\\s]+/)*_next/static/[^\"'<>?#\\\\\\s]+(?:[?#][^\"'<>\\\\\\s]*)?')(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?)*\\s*/?>"}
          ]
        },
        {
          "id": "powered-by-header",
          "state": "detected",
          "description": "X-Powered-By header reports Next.js",
          "all": [{"source": "header", "name": "X-Powered-By", "pattern": "(?i)^[ \\t]*Next[.]js[ \\t]*$"}]
        }
      ]
    },
    {
      "id": "nuxt",
      "name": "Nuxt",
      "category": "framework",
      "rules": [
        {
          "id": "payload-html-markers",
          "state": "inferred",
          "description": "HTML contains a __NUXT_DATA__ script and a /_nuxt/ script reference",
          "all": [
            {
              "source": "html",
              "pattern": "(?i:<script)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?i:id)\\s*=\\s*(?:\"__NUXT_DATA__\"|'__NUXT_DATA__')(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?)*\\s*/?>"
            },
            {
              "source": "html",
              "pattern": "(?i:<script)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?\\s+)*(?i:src)\\s*=\\s*(?:\"(?:(?:(?i:https?):)?//[^/\"'<>?#\\\\\\s]+/|/|[^/:\"'<>?#\\\\\\s]+/)(?:[^/:\"'<>?#\\\\\\s]+/)*_nuxt/[^\"'<>?#\\\\\\s]+(?:[?#][^\"'<>\\\\\\s]*)?\"|'(?:(?:(?i:https?):)?//[^/\"'<>?#\\\\\\s]+/|/|[^/:\"'<>?#\\\\\\s]+/)(?:[^/:\"'<>?#\\\\\\s]+/)*_nuxt/[^\"'<>?#\\\\\\s]+(?:[?#][^\"'<>\\\\\\s]*)?')(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>`]+))?)*\\s*/?>"
            }
          ]
        },
        {
          "id": "powered-by-header",
          "state": "detected",
          "description": "X-Powered-By header reports Nuxt",
          "all": [
            {
              "source": "header",
              "name": "X-Powered-By",
              "pattern": "(?i)^[ \\t]*Nuxt[ \\t]*$"
            }
          ]
        }
      ]
    },
    {
      "id": "react",
      "name": "React",
      "category": "javascript_framework",
      "rules": [
        {
          "id": "asset-client-runtime",
          "state": "inferred",
          "description": "Paired React client-internals assignment and transitional element symbol suggest React",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*__CLIENT_INTERNALS_DO_NOT_USE_OR_WARN_USERS_THEY_CANNOT_UPGRADE\\s*=\\s*(?:[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)|\\{)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$\\.])Symbol\\s*\\.\\s*for\\s*\\(\\s*(?:\"react\\.transitional\\.element\"|'react\\.transitional\\.element')\\s*\\)"
            }
          ]
        },
        {
          "id": "asset-dom-runtime",
          "state": "inferred",
          "description": "Paired ReactDOM key constructions and production-error formatting suggest React",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[;,{}])\\s*(?:(?:var|let|const)\\s+)?[A-Za-z_$][A-Za-z0-9_$]*\\s*=\\s*(?:\"__reactFiber\\$\"|'__reactFiber\\$')\\s*\\+\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[;,{}])\\s*(?:(?:var|let|const)\\s+)?[A-Za-z_$][A-Za-z0-9_$]*\\s*=\\s*(?:\"__reactProps\\$\"|'__reactProps\\$')\\s*\\+\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[;,{}])\\s*(?:(?:var|let|const)\\s+)?[A-Za-z_$][A-Za-z0-9_$]*\\s*=\\s*(?:\"__reactContainer\\$\"|'__reactContainer\\$')\\s*\\+\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:\"https://(?:reactjs\\.org/docs/error-decoder\\.html\\?invariant=|react\\.dev/errors/)\"|'https://(?:reactjs\\.org/docs/error-decoder\\.html\\?invariant=|react\\.dev/errors/)')\\s*\\+\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:\"Minified React error #\"|'Minified React error #')\\s*\\+\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*\\+\\s*(?:\"; visit \"|'; visit ')"
            }
          ]
        }
      ]
    },
    {
      "id": "rails",
      "name": "Ruby on Rails",
      "category": "framework",
      "rules": [
        {
          "id": "csrf-meta-pair",
          "state": "inferred",
          "description": "Paired csrf-param authenticity_token and csrf-token meta tags suggest Ruby on Rails",
          "all": [
            {
              "source": "html",
              "pattern": "(?i:<meta)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:(?i:name)\\s*=\\s*(?:\"csrf-param\"|'csrf-param')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:content)\\s*=\\s*(?:\"authenticity_token\"|'authenticity_token')|(?i:content)\\s*=\\s*(?:\"authenticity_token\"|'authenticity_token')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:name)\\s*=\\s*(?:\"csrf-param\"|'csrf-param'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            },
            {
              "source": "html",
              "pattern": "(?i:<meta)\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?:(?i:name)\\s*=\\s*(?:\"csrf-token\"|'csrf-token')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:content)\\s*=\\s*(?:\"[^\\s\"'<>]+\"|'[^\\s\"'<>]+')|(?i:content)\\s*=\\s*(?:\"[^\\s\"'<>]+\"|'[^\\s\"'<>]+')\\s+(?:[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?\\s+)*(?i:name)\\s*=\\s*(?:\"csrf-token\"|'csrf-token'))(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:\"[^\"<>]*\"|'[^'<>]*'|[^\\s\"'=<>\\x60]+))?)*\\s*/?>"
            }
          ]
        }
      ],
      "implies": ["ruby"]
    },
    {
      "id": "spring-boot",
      "name": "Spring Boot",
      "category": "framework",
      "rules": [
        {
          "id": "actuator-media-type",
          "state": "detected",
          "description": "Content-Type reports a Spring Boot Actuator API media type; this may be an intermediary",
          "all": [{"source": "header", "name": "Content-Type", "pattern": "(?i)^[ \\t]*application/vnd[.]spring-boot[.]actuator[.]v[23][+]json(?:[ \\t]*;[ \\t]*charset[ \\t]*=[ \\t]*(?:utf-8|\"utf-8\"))?[ \\t]*$"}]
        },
        {
          "id": "whitelabel-error-html",
          "state": "inferred",
          "description": "HTTP error response with paired Whitelabel heading, fallback explanation and structured error details suggests Spring Boot; this may be an intermediary",
          "http_status": {"min": 400, "max": 599},
          "all": [
            {"source": "html", "pattern": "(?i:<h1>)Whitelabel Error Page(?i:</h1>)"},
            {"source": "html", "pattern": "(?i:<p>)This application has no (?:explicit mapping for /error|configured error view), so you are seeing this as a fallback[.](?i:</p>)"},
            {"source": "html", "pattern": "(?i:<div>)(?:\\[[A-Za-z0-9._:-]+\\] )?There was an unexpected error \\(type=[^<>\\r\\n]+, status=[45][0-9]{2}\\)[.](?i:</div>)"}
          ]
        }
      ]
    },
    {
      "id": "vue",
      "name": "Vue",
      "category": "javascript_framework",
      "rules": [
        {
          "id": "asset-renderer-runtime",
          "state": "inferred",
          "description": "Vue runtime flag, app assignment and fragment symbol suggest Vue",
          "all": [
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*(?:\\s*\\(\\s*\\))?\\s*\\.\\s*__VUE__\\s*=\\s*(?:true|!\\s*0)\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*\\s*\\.\\s*__vue_app__\\s*=\\s*[A-Za-z_$][A-Za-z0-9_$]*\\s*(?:[;,}]|$)"
            },
            {
              "source": "asset_javascript",
              "pattern": "(?:^|[^A-Za-z0-9_$\\.])Symbol\\s*\\.\\s*for\\s*\\(\\s*(?:\"v-fgt\"|'v-fgt')\\s*\\)"
            }
          ]
        }
      ]
    }
  ]
}
