{
  "schema_version": 1,
  "technologies": [
    {
      "id": "apache",
      "name": "Apache HTTP Server",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Apache; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*(?i:Apache)(?:/[0-9]+(?:[.][0-9]+)*(?i:-dev)?(?:[ \\t]+(?:\\([\\x20-\\x27\\x2A-\\x5B\\x5D-\\x7E\\t]*\\)|[A-Za-z][A-Za-z0-9._+-]*/[A-Za-z0-9][A-Za-z0-9._+~-]*))*|(?:[ \\t]+\\([\\x20-\\x27\\x2A-\\x5B\\x5D-\\x7E\\t]*\\))*)[ \\t]*$"}]
      }]
    },
    {
      "id": "caddy",
      "name": "Caddy",
      "category": "web_server",
      "rules": [
        {
          "id": "server-header",
          "state": "detected",
          "description": "Server header reports Caddy; this may be an intermediary",
          "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*[Cc][Aa][Dd][Dd][Yy][ \\t]*$"}]
        },
        {
          "id": "via-header",
          "state": "inferred",
          "description": "A standalone HTTP Via recipient named Caddy suggests a Caddy intermediary; the name can be a pseudonym",
          "all": [{"source": "header", "name": "Via", "pattern": "^[ \\t]*(?:1[.][01]|[23][.]0)[ \\t]+[Cc][Aa][Dd][Dd][Yy][ \\t]*$"}]
        }
      ]
    },
    {
      "id": "gunicorn",
      "name": "Gunicorn",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Gunicorn; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*[Gg][Uu][Nn][Ii][Cc][Oo][Rr][Nn][ \\t]*$"}]
      }]
    },
    {
      "id": "iis",
      "name": "Microsoft IIS",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Microsoft-IIS; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "(?i)^[ \\t]*Microsoft-IIS(?:/[0-9]+(?:[.][0-9]+)*)?[ \\t]*$"}]
      }]
    },
    {
      "id": "jetty",
      "name": "Jetty",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Jetty; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*(?i:Jetty)\\([0-9]+(?:[.][0-9]+){2}(?:[.]v[0-9]{8})?\\)[ \\t]*$"}]
      }]
    },
    {
      "id": "kestrel",
      "name": "Kestrel",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Kestrel; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*[Kk][Ee][Ss][Tt][Rr][Ee][Ll][ \\t]*$"}]
      }]
    },
    {
      "id": "nginx",
      "name": "nginx",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports nginx; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*(?i:nginx)(?:/[0-9]+(?:[.][0-9]+)*)?(?:[ \\t]+\\([\\x20-\\x27\\x2A-\\x5B\\x5D-\\x7E\\t]*\\))?[ \\t]*$"}]
      }]
    },
    {
      "id": "tomcat",
      "name": "Apache Tomcat",
      "category": "web_server",
      "rules": [
        {
          "id": "error-report-html",
          "state": "inferred",
          "description": "HTTP error response with paired status title/heading and an Apache Tomcat footer suggests Tomcat; this may be an intermediary",
          "http_status": {"min": 400, "max": 599},
          "all": [
            {"source": "html", "pattern": "(?i:<title>)HTTP Status [45][0-9]{2} – [^<>\\r\\n]+(?i:</title>)"},
            {"source": "html", "pattern": "(?i:<h1>)HTTP Status [45][0-9]{2} – [^<>\\r\\n]+(?i:</h1>)"},
            {"source": "html", "pattern": "(?i:<h3>)Apache Tomcat/[0-9]+(?:[.][0-9]+){2}(?i:</h3>)"}
          ]
        },
        {
          "id": "powered-by-header",
          "state": "detected",
          "description": "X-Powered-By reports a Servlet/JSP banner with Apache Tomcat identity; this may be an intermediary",
          "all": [{"source": "header", "name": "X-Powered-By", "pattern": "^[ \\t]*(?i:Servlet)/[0-9]+[.][0-9]+[ \\t]+(?i:JSP)/[0-9]+[.][0-9]+[ \\t]+\\((?i:Apache[ \\t]+Tomcat)/[0-9]+(?:[.][0-9]+){2}[ \\t]+(?i:Java)/[A-Za-z0-9][A-Za-z0-9 ._+~-]*/[0-9][0-9A-Za-z._+~-]*\\)[ \\t]*$"}]
        },
        {
          "id": "server-header",
          "state": "detected",
          "description": "Server header reports Apache Tomcat; this may be an intermediary",
          "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*(?i:Apache[ \\t]+Tomcat)(?:/[0-9]+(?:[.][0-9]+){2})?[ \\t]*$"}]
        }
      ]
    },
    {
      "id": "uvicorn",
      "name": "Uvicorn",
      "category": "web_server",
      "rules": [{
        "id": "server-header",
        "state": "detected",
        "description": "Server header reports Uvicorn; this may be an intermediary",
        "all": [{"source": "header", "name": "Server", "pattern": "^[ \\t]*[Uu][Vv][Ii][Cc][Oo][Rr][Nn][ \\t]*$"}]
      }]
    }
  ]
}
